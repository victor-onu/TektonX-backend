<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Week {{week}} — Mentor Brief</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f4f5" style="background-color:#f4f4f5;">
    <tr><td align="center" style="padding:40px 20px;">

      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background-color:#ffffff;border-radius:8px;overflow:hidden;">

        <!-- HEADER -->
        <tr>
          <td align="center" bgcolor="#0f172a" style="background-color:#0f172a;padding:28px 40px;">
            <img src="{{frontendUrl}}/logo-white-horizontal.svg" alt="TektonX" width="180" style="display:block;height:auto;" />
          </td>
        </tr>

        <!-- COUNTDOWN BAR -->
        <tr>
          <td bgcolor="#0d9488" style="background-color:#0d9488;padding:14px 40px;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
            <table width="100%" cellpadding="0" cellspacing="0"><tr>
              <td style="color:#ffffff;font-size:13px;font-weight:600;">Mentor Brief • Week {{week}} of {{totalWeeks}}{{#if milestone}} • Milestone {{milestone}}{{/if}}</td>
              <td align="right" style="color:#ccfbf1;font-size:12px;">{{weeksRemaining}} weeks remaining</td>
            </tr></table>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:32px 40px;background-color:#ffffff;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
            <h2 style="color:#0f172a;margin:0 0 8px 0;font-size:22px;font-weight:700;">Hi {{name}},</h2>
            <p style="color:#475569;line-height:1.6;font-size:14px;margin:8px 0 24px;">{{intro}}</p>

            <!-- MENTEES LIST -->
            {{#if mentees.length}}
            <p style="color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 8px;font-weight:600;">Your Mentees ({{mentees.length}})</p>
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
              {{#each mentees}}
              <tr>
                <td style="padding:10px 14px;background-color:#f8fafc;border-radius:6px;margin-bottom:6px;">
                  <table width="100%"><tr>
                    <td style="color:#0f172a;font-size:13px;font-weight:600;">{{name}}</td>
                    <td align="right" style="color:#64748b;font-size:11px;">{{track}}</td>
                  </tr></table>
                </td>
              </tr>
              <tr><td style="height:6px;line-height:6px;font-size:0;">&nbsp;</td></tr>
              {{/each}}
            </table>
            {{/if}}

            <!-- TRACK CONTENT -->
            {{#each trackContent}}
            <p style="color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 8px;font-weight:600;">{{track}} — Week {{../week}}</p>
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8fafc;border-radius:8px;margin-bottom:16px;">
              <tr><td style="padding:16px 20px;">
                <p style="color:#0f172a;font-size:14px;font-weight:600;margin:0 0 6px;">{{topic}}</p>
                <p style="color:#475569;font-size:13px;margin:0 0 8px;line-height:1.5;"><strong style="color:#0f172a;">Task:</strong> {{task}}</p>
                {{#if resourceUrl}}
                <p style="margin:0;"><a href="{{resourceUrl}}" style="color:#1d4ed8;font-size:12px;text-decoration:none;">{{resource}} →</a></p>
                {{else}}
                <p style="color:#64748b;font-size:12px;margin:0;">{{resource}}</p>
                {{/if}}
              </td></tr>
            </table>
            {{/each}}

            {{#if programEvent}}
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#fef3c7;border-radius:8px;margin-bottom:24px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#92400e;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">⭐ Program-Wide Event This Week</p>
                <p style="color:#78350f;font-size:14px;font-weight:600;margin:0 0 6px;line-height:1.4;">{{programEvent.title}}</p>
                <p style="color:#92400e;font-size:12px;margin:0;line-height:1.5;white-space:pre-line;">{{programEvent.schedule}}</p>
                <p style="color:#92400e;font-size:12px;margin:8px 0 0;font-style:italic;">Please remind your mentees to attend.</p>
              </td></tr>
            </table>
            {{/if}}

            <!-- CHECK-IN NUDGE -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#ecfdf5;border-left:3px solid #10b981;border-radius:6px;margin-bottom:24px;">
              <tr><td style="padding:16px 20px;">
                <p style="color:#065f46;font-size:13px;margin:0;line-height:1.5;"><strong>This week's nudge:</strong> drop a short message to each mentee in the dashboard. Even a "How's it going?" makes a difference.</p>
              </td></tr>
            </table>

            <!-- CTA -->
            <table cellpadding="0" cellspacing="0"><tr>
              <td><a href="{{dashboardUrl}}" style="display:inline-block;padding:12px 28px;background-color:#0d9488;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;font-size:14px;">Open Mentor Dashboard</a></td>
            </tr></table>

            <p style="color:#94a3b8;font-size:12px;margin:24px 0 0;line-height:1.5;">{{outro}}</p>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td align="center" bgcolor="#f8fafc" style="background-color:#f8fafc;padding:20px 40px;">
            <p style="color:#94a3b8;font-size:12px;margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">&copy; {{year}} TektonX Labs. You're receiving this as an active mentor.</p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
