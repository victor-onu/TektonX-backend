<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Week {{week}} — TektonX</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f4f5" style="background-color:#f4f4f5;">
    <tr><td align="center" style="padding:40px 20px;">

      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background-color:#ffffff;border-radius:8px;overflow:hidden;">

        <!-- HEADER -->
        <tr>
          <td align="center" bgcolor="#0f172a" style="background-color:#0f172a;padding:28px 40px;">
            <img src="{{frontendUrl}}/logo-white-horizontal.svg" alt="TektonX" width="180" style="display:block;height:auto;" />
          </td>
        </tr>

        <!-- COUNTDOWN BAR -->
        <tr>
          <td bgcolor="#7c3aed" style="background-color:#7c3aed;padding:14px 40px;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
            <table width="100%" cellpadding="0" cellspacing="0"><tr>
              <td style="color:#ffffff;font-size:13px;font-weight:600;">Week {{week}} of {{totalWeeks}}{{#if milestone}} • Milestone {{milestone}}{{/if}}</td>
              <td align="right" style="color:#ddd6fe;font-size:12px;">{{weeksRemaining}} weeks to graduation</td>
            </tr></table>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:32px 40px;background-color:#ffffff;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
            <h2 style="color:#0f172a;margin:0 0 8px 0;font-size:22px;font-weight:700;">Hi {{name}},</h2>
            <p style="color:#475569;line-height:1.6;font-size:14px;margin:8px 0 24px;">{{intro}}</p>

            {{#if weekContent}}
            <!-- TOPIC -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8fafc;border-radius:8px;margin-bottom:16px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">This Week's Topic</p>
                <p style="color:#0f172a;font-size:16px;font-weight:600;margin:0;line-height:1.4;">{{weekContent.topic}}</p>
                <p style="color:#94a3b8;font-size:12px;margin:6px 0 0;">{{weekContent.dates}}</p>
              </td></tr>
            </table>

            <!-- TASK -->
            <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e2e8f0;border-radius:8px;margin-bottom:16px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">Your Task</p>
                <p style="color:#0f172a;font-size:14px;margin:0;line-height:1.5;">{{weekContent.task}}</p>
              </td></tr>
            </table>

            <!-- RESOURCE -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#eff6ff;border-radius:8px;margin-bottom:24px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#1e40af;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">Resource of the Week</p>
                {{#if weekContent.resourceUrl}}
                <a href="{{weekContent.resourceUrl}}" style="color:#1d4ed8;font-size:14px;text-decoration:none;font-weight:500;">{{weekContent.resource}} →</a>
                {{else}}
                <p style="color:#1e3a8a;font-size:14px;margin:0;">{{weekContent.resource}}</p>
                {{/if}}
              </td></tr>
            </table>
            {{/if}}

            {{#if programEvent}}
            <!-- PROGRAM EVENT -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#fef3c7;border-radius:8px;margin-bottom:24px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#92400e;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">⭐ Program-Wide Event This Week</p>
                <p style="color:#78350f;font-size:14px;font-weight:600;margin:0 0 6px;line-height:1.4;">{{programEvent.title}}</p>
                <p style="color:#92400e;font-size:12px;margin:0;line-height:1.5;white-space:pre-line;">{{programEvent.schedule}}</p>
              </td></tr>
            </table>
            {{/if}}

            {{#if milestone}}
            <!-- MILESTONE PROGRESS -->
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0fdf4;border-radius:8px;margin-bottom:24px;">
              <tr><td style="padding:18px 20px;">
                <p style="color:#15803d;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 4px;font-weight:600;">Milestone {{milestone}} Progress</p>
                <p style="color:#14532d;font-size:13px;margin:0 0 8px;">You've completed <strong>{{milestoneCompleted}}</strong> task{{#unless milestoneCompletedSingular}}s{{/unless}} in this milestone.</p>
                <a href="{{dashboardUrl}}" style="color:#15803d;font-size:12px;text-decoration:underline;font-weight:500;">View progress →</a>
              </td></tr>
            </table>
            {{/if}}

            <!-- CTA -->
            <table cellpadding="0" cellspacing="0"><tr>
              <td><a href="{{dashboardUrl}}" style="display:inline-block;padding:12px 28px;background-color:#7c3aed;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;font-size:14px;">Open My Dashboard</a></td>
            </tr></table>

            <p style="color:#94a3b8;font-size:12px;margin:24px 0 0;line-height:1.5;">{{outro}}</p>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td align="center" bgcolor="#f8fafc" style="background-color:#f8fafc;padding:20px 40px;">
            <p style="color:#94a3b8;font-size:12px;margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">&copy; {{year}} TektonX Labs. You're receiving this because you're enrolled in the {{track}} track.</p>
          </td>
        </tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
